rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Cette liste DOIT être identique à ADMIN_EMAILS dans firebase-config.js
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'apotrepaulabba@gmail.com'
        ];
    }

    // Profil de chaque Bâtisseur : lisible/modifiable par lui-même, lisible par les coordinateurs
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();

      // Données privées (spirituel + finance + réglages) : uniquement le propriétaire
      match /priv/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Résumé de régularité (pour le tableau de bord coordinateur)
    match /summaries/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Checklist spirituelle partagée
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Tout le reste est refusé par défaut
  }
}
